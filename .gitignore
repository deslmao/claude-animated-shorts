# Secrets: API keys live ONLY in environment variables or a local .env file — never in git.
.env
.env.*
!.env.example
*.key

# Build / render output and caches
node_modules/
out/
dist/
__pycache__/
*.pyc
.DS_Store
remotion-tmp/

# Productions: the finished MP4 is published as a GitHub Release; review frames are re-renderable (the sheet is kept)
productions/*/*.mp4
productions/*/review/
