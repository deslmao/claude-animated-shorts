# Secrets: API keys live ONLY in environment variables or a local .env file — never in git.
.env
.env.*
!.env.example
*.key

# Build / render output and caches
node_modules/
out/
dist/
__pycache__/
*.pyc
.DS_Store
remotion-tmp/

# Productions: the finished MP4 is published as a GitHub Release; review frames are re-renderable (the sheet is kept)
productions/*/*.mp4
productions/*/review/

# graphify: keep the engine knowledge graph (graph.json, report, manifest, labels); ignore the cache, the HTML view
# (regenerable with `graphify export html`) and the interpreter pointer
graphify-out/cache/
graphify-out/graph.html
graphify-out/.graphify_python
graphify-out/cost.json
animation-studio/src/graphify-out/
blender/miami/assets/
