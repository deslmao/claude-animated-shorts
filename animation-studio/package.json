{
  "name": "animation-studio",
  "version": "1.0.0",
  "description": "A React Three Fiber Project",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/zod-types": "4.0.539",
    "mediabunny": "1.62.0",
    "postprocessing": "6.37.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "three": "0.178.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/three": "0.170.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "node scripts/render.mjs",
    "preview": "node scripts/render.mjs --preview",
    "benchmark": "node scripts/benchmark.mjs",
    "stills": "node scripts/stills.mjs",
    "test:framing": "esbuild scripts/framing-test.ts --bundle --platform=node --format=esm --outfile=out/framing-test.mjs --log-level=warning && node out/framing-test.mjs",
    "test:story": "esbuild scripts/storyboard-test.ts --bundle --platform=node --format=esm --outfile=out/storyboard-test.mjs --log-level=warning && node out/storyboard-test.mjs",
    "voice": "esbuild scripts/voice.ts --bundle --platform=node --format=esm --outfile=out/voice.mjs --log-level=warning && NODE_USE_ENV_PROXY=1 node out/voice.mjs",
    "test:regression": "node scripts/regression.mjs",
    "test:library": "esbuild scripts/library-test.ts --bundle --platform=node --format=esm --outfile=out/library-test.mjs --log-level=warning && esbuild scripts/floor-map.ts --bundle --platform=node --format=esm --outfile=out/floor-map.mjs --log-level=warning && esbuild scripts/assets.ts --bundle --platform=node --format=esm --outfile=out/assets.mjs --log-level=warning && node out/library-test.mjs",
    "preflight": "esbuild scripts/preflight.ts --bundle --platform=node --format=esm --outfile=out/preflight.mjs --log-level=warning && node out/preflight.mjs",
    "test": "npm run lint && npm run test:framing && npm run test:story && npm run test:library && npm run test:zfight",
    "sound": "esbuild scripts/sound.ts --bundle --platform=node --format=esm --outfile=out/sound.mjs --log-level=warning && node out/sound.mjs",
    "test:sound": "esbuild scripts/sound.ts --bundle --platform=node --format=esm --outfile=out/sound.mjs --log-level=warning && node out/sound.mjs --catalog > out/sound-catalog.json && python3 sound/check.py out/sound-catalog.json",
    "floor-map": "esbuild scripts/floor-map.ts --bundle --platform=node --format=esm --outfile=out/floor-map.mjs --log-level=warning && node out/floor-map.mjs",
    "assets": "esbuild scripts/assets.ts --bundle --platform=node --format=esm --outfile=out/assets.mjs --log-level=warning && node out/assets.mjs",
    "short": "esbuild scripts/short.ts --bundle --platform=node --format=esm --outfile=out/short.mjs --log-level=warning && NODE_USE_ENV_PROXY=1 node out/short.mjs",
    "script": "esbuild scripts/script.ts --bundle --platform=node --format=esm --outfile=out/script.mjs --log-level=warning && node out/script.mjs",
    "test:zfight": "esbuild scripts/zfight-test.ts --bundle --platform=node --format=esm --outfile=out/zfight-test.mjs --log-level=warning && node out/zfight-test.mjs",
    "stability": "node scripts/stability.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
